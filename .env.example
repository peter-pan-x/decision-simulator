# App metadata
VITE_APP_ID=proj_abc123def456
VITE_APP_TITLE="Decision Simulator"
VITE_APP_LOGO="https://placehold.co/40x40/3b82f6/ffffff?text=D"

# Analytics (optional)
VITE_ANALYTICS_ENDPOINT=https://umami.dev.ops.butterfly-effect.dev
VITE_ANALYTICS_WEBSITE_ID=analytics_proj_abc123def456

# AI mode control
# true: always use mock responses
# false: use real AI if server keys are configured
VITE_USE_MOCK_AI=false

# Browser-direct AI calls are insecure and should stay false in production.
# If set to true, VITE_OPENAI_API_KEY / VITE_GEMINI_API_KEY will be exposed to browser.
VITE_ENABLE_BROWSER_AI=false

# Optional: custom proxy endpoint (defaults to /api/ai)
VITE_AI_PROXY_URL=/api/ai

# Server-side AI keys (recommended)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model overrides
OPENAI_MODEL=gpt-4-turbo-preview
GEMINI_MODEL=gemini-pro

# Only needed when VITE_ENABLE_BROWSER_AI=true (not recommended)
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
