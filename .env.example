VITE_APP_ID=decision_simulator
VITE_APP_TITLE="Decision Simulator"
VITE_APP_LOGO="https://placehold.co/40x40/0f172a/ffffff?text=DS"

# DeepSeek v4 model routing.
# The same server-side API key is used for both the pro and flash models.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_PRO_MODEL=deepseek-v4pro
DEEPSEEK_FLASH_MODEL=deepseek-v4flash

# Optional frontend controls.
VITE_AI_PROXY_PATH=/api/ai/chat
VITE_USE_MOCK_AI=false

VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
